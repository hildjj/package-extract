{
  "name": "package-extract",
  "version": "4.0.2",
  "description": "Extract fields from package.json into an ES6 module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hildjj/package-extract.git"
  },
  "homepage": "https://github.com/hildjj/package-extract",
  "bugs": {
    "url": "https://github.com/hildjj/package-extract/issues"
  },
  "type": "module",
  "bin": {
    "package-extract": "bin/package-extract.js"
  },
  "main": "lib/index.js",
  "types": "./types",
  "files": [
    "package.js",
    "bin",
    "lib",
    "types"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "c8 node --test",
    "ver": "node ./bin/package-extract.js -s -o lib/package.js",
    "build": "npm run ver && npm run types && npm test && npm run lint && npm pack --dry-run",
    "types": "tsc",
    "version": "npm run ver && npm run build && git add lib/package.js types/package.d.ts"
  },
  "keywords": [
    "package.json",
    "version",
    "extract",
    "multiple",
    "code",
    "import",
    "es6",
    "genversion"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "dependencies": {
    "commander": "~15.0.0",
    "semver": "~7.8.5"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "^7.0.3",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "superc8": "^12.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  }
}
